# NORMALDE GEREKMEZ: anahtarlar panelden (Ayarlar → Bağlantı anahtarları) girilir ve
# işletim sisteminin şifreli kasasında saklanır.
# Bu dosya sadece şifreli kasası olmayan bilgisayarlar (ör. bazı sunucular) için yedek yoldur:
# ".env" adıyla kopyalayıp doldurun ve kimseyle paylaşmayın.

# Telegram (BotFather'dan alınan token ve kendi chat ID'niz)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Helius API anahtarı (Aşama 2'de gerekecek)
HELIUS_API_KEY=
